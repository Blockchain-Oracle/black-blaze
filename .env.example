# StageMe local paths (documentation convenience; preflight consumes explicit CLI flags).
# Required before the first authorized model call.
# Keep both locations outside Git. Do not put human media in this repository.
STAGEME_WORK_ROOT=
STAGEME_FIXTURE_PATH=
STAGEME_CONSENT_PATH=
STAGEME_BUDGET_PLAN_PATH=
ANYACCOMP_CHECKPOINT_ROOT=

# Human-approved first-call controls. These are configuration, not credentials.
STAGEME_PROJECT_ID=
STAGEME_GPU_PROVIDER=
STAGEME_GPU_REGION=
STAGEME_SPEND_CAP_USD=
STAGEME_WORKER_IMAGE=

# Hosted AnyAccomp phase only. Values belong in a local secret store/.env.
ANYACCOMP_API_URL=
ANYACCOMP_API_TOKEN=

# Hosted ACE-Step comparison/repaint phase only.
ACESTEP_API_URL=
ACESTEP_API_TOKEN=

# Real B2 canary phase only. Use a private test bucket and scoped key.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=
B2_PREFIX=

# Optional Wan hero-interval phase only; never required for core StageMe.
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
